        {
          "name": "Create public film",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Film\",\n  \"private\": false,\n  \"watchDate\": \"2026-06-04\",\n  \"rating\": 8,\n  \"favorite\": false\n}"
            },
            "url": "{{baseUrl}}/api/films"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body;",
                  "pm.test('film creation returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('film creation returns JSON with an id', function () {",
                  "  body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(String(body.id)).to.not.eql('');",
                  "});",
                  "if (pm.response.code === 201 && body && body.id !== undefined && body.id !== null && String(body.id) !== '') {",
                  "  pm.collectionVariables.set('createdFilmId', String(body.id));",
                  "  console.log('createdFilmId set to ' + body.id);",
                  "} else {",
                  "  console.error('Create public film did not return 201 with an id. Status: ' + pm.response.code + '. Body: ' + pm.response.text());",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update created film",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
