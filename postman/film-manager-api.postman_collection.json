              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('visibility change conflict is detected', function () {",
                  "  pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject missing image film",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/films/999/images"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('missing image parent film returns not found', function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject unsupported image representation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "url": "{{baseUrl}}/api/films/{{createdFilmId}}/images/{{createdImageId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('createdImageId')) {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('unsupported image representation is rejected', function () {",
                  "  pm.response.to.have.status(406);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cleanup",
      "description": "Run last. The conflict scenario logs in as Karen, so cleanup logs Frank back in before deleting Frank-owned data.",
      "item": [
        {
          "name": "Login as Frank",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"frank@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": "{{baseUrl}}/api/sessions"
          }
        },
        {
          "name": "Delete created film",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/films/{{createdFilmId}}"
          }
        },
        {
          "name": "Clear active film",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/users/current/active-film"
          }
        }
      ]
    }
  ]
}
