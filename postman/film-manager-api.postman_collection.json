    {
      "name": "Images",
      "description": "Create a public film first. For upload, choose a local PNG, JPG, or GIF file in the Postman file picker.",
      "item": [
        {
          "name": "List images",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/films/{{createdFilmId}}/images"
          }
        },
        {
          "name": "Upload image",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": "{{baseUrl}}/api/films/{{createdFilmId}}/images"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const restartMessage = \"Run 'Create public film' after the latest server start before uploading an image. The backend uses in-memory data, so created IDs are reset when the server restarts.\";",
                  "const baseUrl = pm.variables.get('baseUrl');",
                  "const collectionFilmId = pm.collectionVariables.get('createdFilmId');",
                  "const resolvedFilmId = pm.variables.get('createdFilmId');",
                  "if (!baseUrl) {",
                  "  throw new Error('baseUrl is not set. ' + restartMessage);",
                  "}",
                  "if (!collectionFilmId || !/^\\d+$/.test(String(collectionFilmId)) || Number(collectionFilmId) <= 0) {",
                  "  throw new Error('createdFilmId must be a positive integer. ' + restartMessage);",
                  "}",
                  "if (String(resolvedFilmId) !== String(collectionFilmId)) {",
                  "  throw new Error('A higher-precedence variable is shadowing the collection createdFilmId. Remove the environment, data, or local createdFilmId value and rerun Create public film.');",
                  "}",
                  "console.log('Upload target: baseUrl=' + baseUrl + ', createdFilmId=' + collectionFilmId);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expectedFilmId = Number(pm.collectionVariables.get('createdFilmId'));",
                  "if (pm.response.code !== 201) {",
                  "  console.error('Upload failed. Status: ' + pm.response.code + '. Body: ' + pm.response.text());",
                  "}",
                  "pm.test('upload returns 201', function () {",
                  "  pm.expect(pm.response.code, 'Upload did not return 201. The stored film ID may be stale after a server restart. Response: ' + pm.response.text()).to.eql(201);",
                  "});",
                  "let image;",
                  "pm.test('upload returns valid JSON', function () {",
                  "  image = pm.response.json();",
                  "  pm.expect(image).to.be.an('object');",
                  "});",
                  "pm.test('upload response contains image metadata', function () {",
                  "  pm.expect(image).to.include.all.keys('id', 'filmId', 'name', 'mediaType', 'self');",
                  "  pm.expect(Number(image.filmId)).to.eql(expectedFilmId);",
                  "});",
                  "if (pm.response.code === 201 && image) {",
                  "  pm.collectionVariables.set('createdImageId', String(image.id));",
                  "  console.log('Upload succeeded for film ' + expectedFilmId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get image metadata",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/films/{{createdFilmId}}/images/{{createdImageId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('runImageUpload') !== 'true' || !pm.collectionVariables.get('createdImageId')) {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get image file",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "image/png"
              }
            ],
            "url": "{{baseUrl}}/api/films/{{createdFilmId}}/images/{{createdImageId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('runImageUpload') !== 'true' || !pm.collectionVariables.get('createdImageId')) {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete image",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/films/{{createdFilmId}}/images/{{createdImageId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('runImageUpload') !== 'true' || !pm.collectionVariables.get('createdImageId')) {",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ]
        }
      ]
